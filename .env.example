# Environment
APP_ENV=dev

# Postgres (используется docker-compose и healthcheck)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=petshop

# Database connection string (обязательное)
DATABASE_URL=postgres://user:password@postgres:5432/petshop?sslmode=disable

# Database timeout (опционально)
DB_TIMEOUT=10s
